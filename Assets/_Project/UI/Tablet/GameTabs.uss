/* AI-assisted: written with Claude. See docs/AI_USE.md */
/* Styles of the tablet tabs made in C# (PowerTabView, CrewTabView, CommsTabView). Colours come from Theme.uss. */

.gt-pane { flex-grow: 1; flex-direction: row; padding: 12px; }
.gt-side { width: 360px; margin-right: 14px; padding: 12px 14px; border-width: 1px; border-color: var(--color-line);
           background-color: rgba(95, 212, 244, 0.04); }
.gt-main { flex-grow: 1; flex-shrink: 1; }
.gt-head { font-size: 13px; letter-spacing: 2px; color: var(--color-muted); margin-bottom: 4px; }
.gt-big { font-size: 22px; letter-spacing: 1px; -unity-font-style: bold; color: var(--color-accent); margin-bottom: 4px; }
.gt-big--en { color: var(--color-energy); }
.gt-big--ok { color: var(--color-ok); }
.gt-big--warn { color: var(--color-warn); }
.gt-big--bad { color: var(--color-alarm); }
.gt-text { font-size: 14px; color: var(--color-soft); white-space: normal; margin-bottom: 10px; }
.gt-text--warn { color: var(--color-warn); }
.gt-text--good { color: var(--color-ok); }
.gt-gap { height: 10px; }
.gt-msg { min-height: 22px; margin-top: 6px; font-size: 15px; color: var(--color-ok); white-space: normal; }
.gt-msg--err { color: var(--color-alarm); }
.gt-note { padding: 8px 12px; border-left-width: 3px; border-color: var(--color-accent); background-color: rgba(95, 212, 244, 0.07);
           font-size: 14px; color: var(--color-soft); white-space: normal; margin-bottom: 8px; }
.gt-note--fact { border-color: var(--color-energy); background-color: rgba(255, 200, 61, 0.06); }

/* bar of segments (battery) */
.gt-bar { flex-direction: row; height: 18px; margin: 4px 0 6px 0; }
.gt-bar__seg { flex-grow: 1; margin-right: 2px; background-color: rgba(255, 255, 255, 0.07); }
.gt-bar__seg--on { background-color: var(--color-energy); }
.gt-bar__seg--low { background-color: var(--color-warn); }

/* ---------- POWER ---------- */
.pw-row { flex-direction: row; align-items: center; min-height: 56px; margin-bottom: 6px; padding: 4px 10px;
          background-color: var(--color-card); border-width: 2px; border-color: var(--color-line); }
.pw-row--short { border-color: var(--color-warn); }
.pw-name { width: 200px; }
.pw-title { font-size: 16px; letter-spacing: 1px; -unity-font-style: bold; color: var(--color-text); }
.pw-desc { font-size: 12px; color: var(--color-muted); white-space: normal; }
.pw-pm { width: 42px; height: 40px; margin: 0; padding: 0; flex-grow: 0; font-size: 24px; -unity-font-style: bold;
         background-color: rgba(0, 0, 0, 0); border-width: 2px; border-color: var(--color-accent); border-radius: 0; color: var(--color-accent); }
.pw-pm:hover { background-color: rgba(95, 212, 244, 0.15); }
.pw-pips { flex-direction: row; margin: 0 8px; }
.pw-pip { width: 24px; height: 22px; margin-right: 4px; border-width: 2px; border-color: var(--color-dim); }
.pw-pip--on { background-color: var(--color-energy); border-color: var(--color-energy); }
.pw-pip--short { background-color: var(--color-warn); border-color: var(--color-warn); }
.pw-effect { flex-grow: 1; flex-shrink: 1; margin-left: 12px; font-size: 14px; color: var(--color-soft); white-space: normal; }
.pw-effect--bad { color: var(--color-warn); }
.pw-effect--good { color: var(--color-ok); }

/* ---------- CREW ---------- */
.cr-card { margin: 0 0 8px 0; padding: 8px 12px; background-color: var(--color-card); border-width: 2px; border-color: var(--color-line); }
.cr-card--warn { border-color: var(--color-warn); }
.cr-head { flex-direction: row; align-items: center; flex-wrap: wrap; }
.cr-name { font-size: 18px; -unity-font-style: bold; color: var(--color-text); margin-right: 10px; }
.cr-role { font-size: 13px; letter-spacing: 2px; color: var(--color-accent); margin-right: 10px; }
.cr-chip { margin: 0 6px 0 0; padding: 2px 8px; font-size: 12px; letter-spacing: 1px; border-width: 1.5px; border-color: var(--color-muted); color: var(--color-muted); }
.cr-chip--ok { color: var(--color-ok); border-color: var(--color-ok); }
.cr-chip--warn { color: var(--color-warn); border-color: var(--color-warn); }
.cr-chip--bad { color: var(--color-alarm); border-color: var(--color-alarm); }
.cr-chip--acc { color: var(--color-accent); border-color: var(--color-accent); }
.cr-stats { font-size: 13px; color: var(--color-soft); margin: 4px 0; white-space: normal; }
.cr-tasks { flex-direction: row; flex-wrap: wrap; }
.cr-task { height: 34px; margin: 0 6px 4px 0; padding: 0 10px; font-size: 13px; letter-spacing: 1px;
           background-color: rgba(0, 0, 0, 0); border-width: 2px; border-color: var(--color-line); border-radius: 0; color: var(--color-soft); }
.cr-task:hover { border-color: var(--color-accent); }
.cr-task--best { border-color: var(--color-energy); }
.cr-task--on { border-color: var(--color-accent); background-color: var(--color-card-selected); color: var(--color-accent); -unity-font-style: bold; }
.cr-all { height: 48px; margin-top: 8px; font-size: 15px; letter-spacing: 1px; background-color: rgba(0, 0, 0, 0);
          border-width: 2px; border-color: var(--color-radiation); border-radius: 0; color: var(--color-radiation); }
.cr-all:hover { background-color: rgba(165, 105, 232, 0.15); }

/* ---------- MAP (MapTabView.cs) ---------- */
.mp-area { width: 470px; height: 470px; flex-shrink: 0; overflow: hidden; background-color: #05090F;
           border-width: 2px; border-color: var(--color-line); }
.mp-area--storm { border-color: var(--color-alarm); }
.mp-ground { position: absolute; background-color: #1C232B; border-width: 2px; border-color: var(--color-line-hi); }
.mp-ring { position: absolute; border-width: 1px; border-color: rgba(111, 147, 173, 0.35); }
.mp-ring-label { position: absolute; font-size: 10px; color: var(--color-muted); }
.mp-dot { position: absolute; }
.mp-dot--module { background-color: var(--color-accent); }
.mp-dot--building { background-color: var(--color-energy); }
.mp-dot--crew { background-color: var(--color-ok); }
.mp-dot--you { background-color: #FFFFFF; border-width: 3px; border-color: var(--color-accent); }
.mp-dot--poi { border-width: 2px; border-color: #FFFFFF; }
.mp-dot--Ice { background-color: var(--color-oxygen); }
.mp-dot--Sample { background-color: var(--color-warn); }
.mp-dot--Fact { background-color: var(--color-energy); }
.mp-dot--LandingPad { background-color: #FFFFFF; }
.mp-dot--unknown { background-color: rgba(0, 0, 0, 0.55); border-color: var(--color-muted); }
.mp-q { position: absolute; left: -1px; top: -4px; width: 13px; font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; color: var(--color-text); }
.mp-label { position: absolute; font-size: 11px; color: var(--color-soft); }
.mp-label--base { color: var(--color-accent); }
.mp-row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.mp-row-text { flex-shrink: 1; font-size: 13px; color: var(--color-soft); white-space: normal; }
.mp-swatch { width: 12px; height: 12px; flex-shrink: 0; margin-right: 8px; border-radius: 6px; }
.mp-swatch--you { background-color: #FFFFFF; border-width: 2px; border-color: var(--color-accent); }
.mp-swatch--module { background-color: var(--color-accent); border-radius: 0; }
.mp-swatch--crew { background-color: var(--color-ok); }
.mp-swatch--Ice { background-color: var(--color-oxygen); }
.mp-swatch--Sample { background-color: var(--color-warn); }
.mp-swatch--Fact { background-color: var(--color-energy); }
.mp-swatch--LandingPad { background-color: #FFFFFF; }
.mp-swatch--unknown { background-color: rgba(0, 0, 0, 0.55); border-width: 1.5px; border-color: var(--color-muted); }

/* ---------- COMMS ---------- */
.cm-window { flex-direction: row; align-items: center; height: 40px; margin-bottom: 6px; padding: 0 12px;
             background-color: var(--color-card); border-width: 2px; border-color: var(--color-line); font-size: 15px; color: var(--color-soft); }
.cm-window--now { border-color: var(--color-ok); color: var(--color-ok); }
.cm-led { width: 14px; height: 14px; border-radius: 7px; margin-right: 10px; background-color: var(--color-muted); }
.cm-led--ok { background-color: var(--color-ok); }
.cm-led--wait { background-color: var(--color-energy); }
.cm-led--off { background-color: var(--color-alarm); }
