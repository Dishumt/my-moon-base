<!-- AI-assisted: written with Claude. See docs/AI_USE.md -->
<!-- Evening report, chapter complete and mission stopped windows (GameWindows.cs). While one is open the game is paused. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="/Assets/_Project/UI/Common/Theme.uss" />
    <Style src="/Assets/_Project/UI/Game/GameUi.uss" />
    <ui:VisualElement name="win-stage" class="win-stage" style="display: none;">
        <ui:VisualElement name="win" class="win">
            <ui:Label name="win-title" class="win-title" />
            <ui:Label name="win-sub" class="win-sub" />
            <ui:ScrollView name="win-lines" class="win-lines" />
            <ui:Label name="win-goals" class="win-goals" />
            <ui:VisualElement class="win-buttons">
                <ui:Button name="win-b1" class="win-btn win-btn--main" />
                <ui:Button name="win-b2" class="win-btn" />
                <ui:Button name="win-b3" class="win-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- pause menu (GameMenu.cs): Esc or the MENU button -->
    <ui:VisualElement name="pause-stage" class="win-stage" style="display: none;">
        <ui:VisualElement name="pause" class="win pause">
            <ui:Label name="pause-title" class="win-title" />
            <ui:Label name="pause-sub" class="win-sub" />
            <ui:Button name="pause-resume" class="win-btn win-btn--main pause-btn" />
            <ui:Button name="pause-help" class="win-btn pause-btn" />
            <ui:Button name="pause-sound" class="win-btn pause-btn" />
            <ui:Button name="pause-lang" class="win-btn pause-btn" />
            <ui:Button name="pause-restart" class="win-btn pause-btn" />
            <ui:Button name="pause-menu" class="win-btn pause-btn" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- how to play (GameMenu.cs): H, the HELP button or the pause menu; shown once by itself on the first landing -->
    <ui:VisualElement name="help-stage" class="win-stage" style="display: none;">
        <ui:VisualElement name="help" class="win help">
            <ui:Label name="help-title" class="win-title" />
            <ui:ScrollView name="help-lines" class="win-lines" />
            <ui:Button name="help-close" class="win-btn win-btn--main" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
