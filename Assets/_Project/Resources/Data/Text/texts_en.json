    { "key": "report.dose_why_shielded", "text": "{0} was in a module covered with regolith (Moon soil): a small dose." },
    { "key": "report.dose_why_storm_outside", "text": "{0} was outside in a solar storm: a big dose!" },
    { "key": "report.dose_why_storm_module", "text": "{0} hid in a normal module in the storm. A shelter with power is safer." },
